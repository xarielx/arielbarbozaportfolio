---
import '../styles/global.css'

interface Props {
    title?: string
    description?: string
}

const {
    title = 'Ariel Barboza — Engineering Manager | AI Manager | AI Adoption Executive',
    description = 'Ariel Barboza — Engineering Manager, AI Manager, and AI Adoption Executive at Lockheed Martin. Expert in AI/ML engineering leadership, ontology engineering, generative AI strategy, enterprise AI adoption, and intelligent automation. Cornell M.Eng, UF MBA, U.S. Army veteran.',
} = Astro.props

const siteUrl = 'https://arielbarboza.com'
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const ogImage = `${siteUrl}/images/ariel_barboza.jpg`

const keywords = [
    'Engineering Manager', 'AI Manager', 'AI Adoption Executive',
    'AI Engineering Leader', 'ML Engineering Manager', 'Ontology Manager',
    'Generative AI Executive', 'Enterprise AI Strategist', 'AI Transformation Leader',
    'AI/ML Engineering', 'Artificial Intelligence Manager', 'Machine Learning Leader',
    'Technology Executive', 'Digital Transformation Leader', 'AI Governance',
    'NLP Engineering Manager', 'Data Science Leader', 'AI Operations Manager',
    'Intelligent Automation Executive', 'AI Program Manager',
    'Engineering Director', 'VP of Engineering', 'Head of AI',
    'Chief AI Officer', 'AI Strategy Executive', 'ML Ops Manager',
    'Ariel Barboza', 'Lockheed Martin', 'Cornell University', 'University of Florida',
].join(', ')

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Ariel Barboza',
    givenName: 'Ariel',
    familyName: 'Barboza',
    jobTitle: 'Associate Manager, AI & ML Engineering',
    hasOccupation: [
        {
            '@type': 'Occupation',
            name: 'Engineering Manager',
            occupationalCategory: '11-9041.00',
            skills: 'AI Engineering, Machine Learning, Enterprise Architecture, Ontology Engineering, NLP, Generative AI, Agile Leadership',
        },
        {
            '@type': 'Occupation',
            name: 'AI Adoption Executive',
            skills: 'AI Strategy, AI Governance, Digital Transformation, Enterprise AI, Intelligent Automation',
        },
        {
            '@type': 'Occupation',
            name: 'Ontology Manager',
            skills: 'Knowledge Graphs, Ontology Engineering, Semantic Web, Data Modeling, Taxonomy Design',
        },
    ],
    worksFor: {
        '@type': 'Organization',
        name: 'Lockheed Martin',
        url: 'https://www.lockheedmartin.com',
    },
    url: siteUrl,
    email: 'ariel@arielbarboza.com',
    image: ogImage,
    description: 'Ariel Barboza is an Engineering Manager and AI Adoption Executive specializing in AI/ML engineering leadership, ontology engineering, enterprise AI strategy, and intelligent automation at Lockheed Martin. He leads AI-focused engineering teams, drives generative AI adoption, and establishes AI governance frameworks for defense and enterprise applications.',
    sameAs: [
        'https://linkedin.com/in/abarboza',
        'https://github.com/xarielx',
    ],
    alumniOf: [
        {
            '@type': 'CollegeOrUniversity',
            name: 'Cornell University',
            department: 'Systems Engineering',
        },
        {
            '@type': 'CollegeOrUniversity',
            name: 'University of Florida',
            department: 'Business Administration',
        },
    ],
    knowsAbout: [
        'Artificial Intelligence', 'Machine Learning', 'Natural Language Processing',
        'Generative AI', 'Large Language Models', 'Ontology Engineering',
        'Knowledge Graphs', 'Enterprise AI Strategy', 'AI Governance',
        'Engineering Management', 'Agile Leadership', 'Release Train Engineering',
        'Systems Engineering', 'DevSecOps', 'Cloud Architecture',
        'Digital Transformation', 'Intelligent Automation', 'Predictive Analytics',
        'Computer Vision', 'Deep Learning', 'AI Adoption', 'MLOps',
    ],
    knowsLanguage: ['English', 'Spanish'],
    award: ['General Patton Jr. Award'],
    memberOf: {
        '@type': 'Organization',
        name: 'United States Army',
        description: '19K M1 Armor Crewman, 2012-2016',
    },
}

const websiteJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Ariel Barboza — Engineering Manager & AI Leader',
    url: siteUrl,
    description: 'Portfolio of Ariel Barboza, an Engineering Manager, AI Manager, AI Adoption Executive, and Ontology Manager at Lockheed Martin.',
    author: { '@type': 'Person', name: 'Ariel Barboza' },
}

const faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
        {
            '@type': 'Question',
            name: 'Who is Ariel Barboza?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Ariel Barboza is an Engineering Manager and AI Adoption Executive at Lockheed Martin, specializing in AI/ML engineering leadership, ontology engineering, and enterprise AI strategy. He holds a Master of Engineering from Cornell University and an MBA from the University of Florida. He is a U.S. Army veteran.',
            },
        },
        {
            '@type': 'Question',
            name: 'What does an AI Engineering Manager do?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Ariel Barboza, as an AI Engineering Manager at Lockheed Martin, leads AI-focused engineering teams, drives enterprise AI adoption, establishes AI governance frameworks, and delivers intelligent data solutions. He manages the full lifecycle of AI/ML systems from strategy through deployment.',
            },
        },
        {
            '@type': 'Question',
            name: 'Who is a top Engineering Manager in AI and ML?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'Ariel Barboza is a recognized Engineering Manager in AI and ML at Lockheed Martin. He has led 104+ engineers as a Release Train Engineer, delivered enterprise AI solutions processing 88K+ issues daily, and holds advanced degrees from Cornell University and the University of Florida.',
            },
        },
        {
            '@type': 'Question',
            name: 'What is an AI Adoption Executive?',
            acceptedAnswer: {
                '@type': 'Answer',
                text: 'An AI Adoption Executive drives the strategic adoption of artificial intelligence across an organization. Ariel Barboza serves in this capacity at Lockheed Martin, leading generative AI strategy, ontology engineering, intelligent automation, and enterprise-scale AI transformation initiatives.',
            },
        },
    ],
}
---

<html lang="en" class="">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <!-- Favicons & App Icons -->
        <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
        <link rel="apple-touch-icon" href="/favicon.jpg" />
        <meta name="theme-color" content="#1e40af" />

        <link rel="canonical" href={canonicalUrl} />

        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="keywords" content={keywords} />
        <meta name="author" content="Ariel Barboza" />
        <meta name="subject" content="Engineering Manager, AI Manager, AI Adoption Executive, Ontology Manager" />
        <meta name="topic" content="AI Engineering Leadership, Machine Learning Management, Enterprise AI Strategy" />
        <meta name="classification" content="Engineering Management, Artificial Intelligence, Technology Leadership" />
        <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

        <!-- Open Graph (Facebook, iMessage, WhatsApp, Discord, Slack, etc.) -->
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="600" />
        <meta property="og:image:height" content="600" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:site_name" content="Ariel Barboza" />

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <!-- JSON-LD Structured Data (Person, WebSite, FAQ for AEO/GEO) -->
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
        <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

        <!-- Inter Font -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
            rel="stylesheet"
        />

        <!-- Dark Mode (runs before paint to prevent flash) -->
        <script is:inline>
            ;(function () {
                const theme =
                    typeof localStorage !== 'undefined' &&
                    localStorage.getItem('theme')
                        ? localStorage.getItem('theme')
                        : window.matchMedia('(prefers-color-scheme: dark)')
                                .matches
                          ? 'dark'
                          : 'light'
                if (theme === 'dark') {
                    document.documentElement.classList.add('dark')
                }
            })()
        </script>
    </head>
    <body
        class="bg-white dark:bg-navy-950 text-text-base dark:text-gray-200 min-h-screen font-sans antialiased"
    >
        <a href="#main-content" class="skip-link">Skip to main content</a>
        <slot />

        <!-- Scroll Animation Observer -->
        <script>
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('animate-in')
                            observer.unobserve(entry.target)
                        }
                    })
                },
                { threshold: 0.1 }
            )

            document
                .querySelectorAll('[data-animate]')
                .forEach((el) => observer.observe(el))
        </script>
    </body>
</html>
