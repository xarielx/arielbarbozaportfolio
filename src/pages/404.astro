---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---

<Layout title="Page Not Found — Ariel Barboza">
    <Header />
    <main id="main-content" class="min-h-screen flex items-center justify-center">
        <div class="text-center px-6">
            <p class="text-8xl font-extrabold text-primary mb-4">404</p>
            <h1 class="text-3xl font-bold text-navy-900 dark:text-white mb-4">
                Page Not Found
            </h1>
            <p class="text-lg text-text-muted dark:text-navy-300 mb-8">
                The page you're looking for doesn't exist.
            </p>
            <a
                href="/"
                class="inline-flex items-center gap-2 bg-primary hover:bg-navy-600 text-white font-semibold py-3 px-8 rounded-lg transition-colors"
            >
                Back to Home
            </a>
        </div>
    </main>
    <Footer />
</Layout>
