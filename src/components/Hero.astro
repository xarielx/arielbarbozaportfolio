---
import { socialMedia, buttonLink } from '../data/site'
---

<section class="bg-pattern shadow-inner min-h-screen flex items-center relative overflow-hidden">
    <!-- Subtle gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-navy-50/80 via-transparent to-navy-100/60 dark:from-navy-950/90 dark:via-navy-950/50 dark:to-navy-900/70 pointer-events-none"></div>

    <div class="bg-white/80 dark:bg-navy-950/80 backdrop-blur-sm w-full py-12 md:py-20 shadow-lg relative z-10">
        <div class="mx-auto container w-4/5 md:w-3/5">
            <div class="flex flex-col-reverse md:flex-row items-center gap-10 md:gap-16">
                <!-- Text Content -->
                <div class="flex-1 text-center md:text-left">
                    <p
                        class="uppercase font-bold text-lg text-primary tracking-wider fade-in-up"
                        style="animation-delay: 0.2s"
                    >
                        Ariel Barboza
                    </p>

                    <h1
                        class="font-extrabold text-4xl sm:text-5xl md:text-6xl lg:text-7xl mt-4 mb-6 bg-gradient-to-r from-primary to-navy-600 bg-clip-text text-transparent fade-in-up"
                        style="animation-delay: 0.4s"
                    >
                        Engineering Manager &amp; AI Leader
                    </h1>

                    <p
                        class="font-light text-lg sm:text-xl md:text-2xl mb-8 text-text-muted dark:text-navy-300 fade-in-up"
                        style="animation-delay: 0.6s"
                    >
                        Engineering Manager and AI Adoption Executive leading AI/ML engineering teams at <strong class="text-text-base dark:text-white font-medium">Lockheed Martin</strong>.
                        Driving enterprise AI strategy, ontology engineering, generative AI adoption, and intelligent automation at scale.
                        U.S. Army veteran. Cornell M.Eng. UF MBA.
                    </p>

                    <div
                        class="flex flex-wrap gap-4 items-center justify-center md:justify-start mb-8 fade-in-up"
                        style="animation-delay: 0.8s"
                    >
                        <a
                            href={buttonLink.url}
                            class="inline-flex items-center gap-2 bg-primary hover:bg-navy-600 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all hover:shadow-xl hover:-translate-y-0.5"
                        >
                            {buttonLink.name}
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <path d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </a>

                        <div class="flex gap-3 items-center">
                            {
                                socialMedia.map((social) => (
                                    <a
                                        href={social.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={`Visit ${social.name} profile`}
                                        class="w-10 h-10 flex items-center justify-center bg-navy-100 dark:bg-navy-800 rounded-full hover:bg-accent hover:text-white dark:hover:bg-accent transition-all hover:-translate-y-0.5"
                                    >
                                        {social.name === 'LinkedIn' && (
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                                            </svg>
                                        )}
                                        {social.name === 'GitHub' && (
                                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                            </svg>
                                        )}
                                    </a>
                                ))
                            }
                        </div>
                    </div>

                    <div
                        class="flex flex-wrap gap-3 text-sm justify-center md:justify-start fade-in-up"
                        style="animation-delay: 1s"
                    >
                        {
                            ['AI/ML Engineering Manager', 'AI Adoption Executive', 'Ontology Engineering', 'Enterprise AI Strategy'].map((tag) => (
                                <span class="px-4 py-1.5 bg-navy-100 dark:bg-navy-800 rounded-full text-navy-700 dark:text-navy-300 font-medium border border-navy-200 dark:border-navy-700">
                                    {tag}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <!-- Semantic bio for search engines and AI crawlers (visually hidden, accessible) -->
                <div class="sr-only" itemscope itemtype="https://schema.org/Person">
                    <meta itemprop="name" content="Ariel Barboza" />
                    <meta itemprop="jobTitle" content="Engineering Manager, AI & ML Engineering" />
                    <meta itemprop="worksFor" content="Lockheed Martin" />
                    <p>Ariel Barboza is an Engineering Manager, AI Manager, AI Adoption Executive, and Ontology Manager at Lockheed Martin. He is an expert in AI/ML engineering leadership, generative AI strategy, enterprise AI adoption, ontology engineering, knowledge graphs, NLP, large language models, and intelligent automation. He holds a Master of Engineering in Systems Engineering from Cornell University and an MBA from the University of Florida. He is a U.S. Army veteran who served as an M1 Armor Crewman and received the General Patton Jr. Award. Ariel leads AI-focused engineering teams, drives digital transformation, and establishes AI governance frameworks for enterprise and defense applications. He has led 104+ engineers as a Release Train Engineer and built AI solutions processing 88,000+ issues daily.</p>
                </div>

                <!-- Headshot -->
                <div class="flex-shrink-0 fade-in-up" style="animation-delay: 0.3s">
                    <div class="relative">
                        <div class="absolute -inset-3 bg-gradient-to-br from-primary to-accent rounded-full opacity-20 blur-md"></div>
                        <img
                            src="/images/ariel_barboza.jpg"
                            alt="Ariel Barboza"
                            class="relative w-40 h-40 sm:w-52 sm:h-52 md:w-64 md:h-64 rounded-full object-cover object-top shadow-2xl ring-4 ring-white dark:ring-navy-800"
                            width="256"
                            height="256"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
