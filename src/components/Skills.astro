---
import { skillCategories, certifications } from '../data/skills'

const iconMap: Record<string, string> = {
    'fa-compass': 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z',
    'fa-brain': 'M12 2a9 9 0 00-9 9c0 3.03 1.53 5.82 4 7.47V22h2v-2h2v2h2v-2h2v2h2v-3.53c2.47-1.65 4-4.44 4-7.47a9 9 0 00-9-9zm-1 14H9v-2h2v2zm0-4H9V8h2v4zm4 4h-2v-2h2v2zm0-4h-2V8h2v4z',
    'fa-building': 'M4 2v20h16V2H4zm6 16H6v-4h4v4zm0-6H6V8h4v4zm4 6h-4v-4h4v4zm0-6h-4V8h4v4zm4 6h-4v-4h4v4zm0-6h-4V8h4v4z',
    'fa-terminal': 'M20 4H4c-1.11 0-2 .9-2 2v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.89-2-2-2zm0 14H4V8h16v10zm-7-2h5v-2h-5v2zm-4.65-1.35L5 12l3.35-2.65 1.3 1.3L7.3 12l2.35 1.65-1.3 1z',
    'fa-chart-bar': 'M4 9h4v11H4V9zm6-5h4v16h-4V4zm6 8h4v8h-4v-8z',
}
---

<section id="skills" class="py-20 bg-navy-50 dark:bg-navy-900">
    <div class="mx-auto container w-4/5 md:w-3/5">
        <div data-animate class="text-center mb-12">
            <h2 class="text-4xl font-bold mb-3 text-navy-900 dark:text-white">Core Competencies</h2>
            <p class="text-lg text-text-muted dark:text-navy-300">Technical depth meets executive leadership</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {
                skillCategories.map((category, i) => (
                    <div
                        data-animate
                        style={`transition-delay: ${i * 0.1}s`}
                        class="p-6 rounded-xl bg-white dark:bg-navy-800 border border-navy-100 dark:border-navy-700 hover:border-accent/50 hover:shadow-lg transition-all group"
                    >
                        <div class="flex items-center gap-3 mb-4">
                            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                    <path d={iconMap[category.icon] || iconMap['fa-compass']} />
                                </svg>
                            </div>
                            <h3 class="text-lg font-semibold text-navy-900 dark:text-white">
                                {category.title}
                            </h3>
                        </div>
                        <ul class="space-y-1.5">
                            {category.skills.map((skill) => (
                                <li class="text-sm text-text-muted dark:text-navy-300 flex items-center gap-2">
                                    <span class="w-1 h-1 rounded-full bg-accent flex-shrink-0" />
                                    {skill}
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <!-- Certifications -->
        <div data-animate class="mt-10 text-center">
            <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-4">Certifications</h3>
            <div class="flex flex-wrap justify-center gap-3">
                {
                    certifications.map((cert) => (
                        <span class="px-4 py-2 text-sm bg-white dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-full text-navy-700 dark:text-navy-300 font-medium">
                            {cert}
                        </span>
                    ))
                }
            </div>
        </div>
    </div>
</section>
