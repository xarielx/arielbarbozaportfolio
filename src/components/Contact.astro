---
import { siteConfig } from '../data/site'
---

<section id="contact" class="py-20 bg-white dark:bg-navy-950">
    <div class="mx-auto container w-4/5 md:w-3/5">
        <div data-animate class="max-w-xl mx-auto text-center">
            <h2 class="text-4xl font-bold mb-4 text-navy-900 dark:text-white">
                Let's Connect
            </h2>
            <p class="text-lg text-text-muted dark:text-navy-300 mb-8 leading-relaxed">
                Open to conversations about AI/ML engineering leadership, enterprise modernization, and strategic technology partnerships.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a
                    href={`mailto:${siteConfig.email}`}
                    class="inline-flex items-center gap-2 bg-primary hover:bg-navy-600 text-white font-semibold py-3 px-8 rounded-lg shadow-lg transition-all hover:shadow-xl hover:-translate-y-0.5"
                >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                    Get In Touch
                </a>

                <a
                    href="https://linkedin.com/in/abarboza"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 border-2 border-navy-200 dark:border-navy-700 hover:border-accent text-navy-700 dark:text-navy-300 hover:text-primary dark:hover:text-accent font-semibold py-3 px-8 rounded-lg transition-all hover:-translate-y-0.5"
                >
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                    </svg>
                    LinkedIn
                </a>
            </div>
        </div>
    </div>
</section>
