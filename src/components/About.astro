<section id="about" class="py-20 bg-white dark:bg-navy-950">
    <div class="mx-auto container w-4/5 md:w-3/5">
        <div data-animate>
            <h2 class="text-4xl font-bold mb-8 text-navy-900 dark:text-white">
                About
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <!-- Left: Role & Impact -->
                <div>
                    <p class="text-lg text-text-muted dark:text-navy-300 mb-6 leading-relaxed">
                        <strong class="text-text-base dark:text-white">Associate Manager, AI & ML Engineering</strong> at Lockheed Martin,
                        providing technical and people leadership for AI-focused engineering teams that deliver enterprise modernization at scale.
                    </p>

                    <p class="text-text-muted dark:text-navy-300 mb-6 leading-relaxed">
                        I drive the development of intelligent data solutions and collaborate with senior leadership to shape enterprise AI strategy.
                        I establish engineering standards, governance practices, and delivery frameworks that enable consistent, high-quality outcomes.
                        Previously served as Release Train Engineer leading 104+ engineers across 10 Agile teams.
                    </p>

                    <!-- Languages -->
                    <div>
                        <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-3">Languages</h3>
                        <div class="flex gap-3">
                            <span class="px-3 py-1 text-sm bg-navy-50 dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-full text-navy-700 dark:text-navy-300">English</span>
                            <span class="px-3 py-1 text-sm bg-navy-50 dark:bg-navy-800 border border-navy-200 dark:border-navy-700 rounded-full text-navy-700 dark:text-navy-300">Spanish</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Education & Military -->
                <div>
                    <!-- Education -->
                    <div class="mb-8">
                        <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-4">Education</h3>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent/10 text-accent flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-navy-900 dark:text-white">MBA, Executive Business Administration</p>
                                    <p class="text-sm text-text-muted dark:text-navy-400">University of Florida — 2025</p>
                                </div>
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent/10 text-accent flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-navy-900 dark:text-white">M.Eng, Systems Engineering</p>
                                    <p class="text-sm text-text-muted dark:text-navy-400">Cornell University</p>
                                </div>
                            </li>
                            <li class="flex items-start gap-3">
                                <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent/10 text-accent flex-shrink-0 mt-0.5">
                                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"></path></svg>
                                </div>
                                <div>
                                    <p class="font-semibold text-navy-900 dark:text-white">B.S., Computer Science</p>
                                    <p class="text-sm text-text-muted dark:text-navy-400">University of Florida</p>
                                </div>
                            </li>
                        </ul>
                    </div>

                    <!-- Military -->
                    <div>
                        <h3 class="text-sm font-semibold uppercase tracking-wider text-primary mb-4">Military Service</h3>
                        <div class="flex items-start gap-3">
                            <div class="w-8 h-8 flex items-center justify-center rounded-lg bg-accent/10 text-accent flex-shrink-0 mt-0.5">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1.323l3.954 1.582 1.599-.8a1 1 0 01.894 1.79l-1.233.616 1.738 5.42a1 1 0 01-.285 1.05A3.989 3.989 0 0115 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.715-5.349L10 6.073 6.237 7.582l1.715 5.349a1 1 0 01-.285 1.05A3.989 3.989 0 015 15a3.989 3.989 0 01-2.667-1.019 1 1 0 01-.285-1.05l1.738-5.42-1.233-.617a1 1 0 01.894-1.788l1.599.799L9 4.323V3a1 1 0 011-1z" clip-rule="evenodd"></path></svg>
                            </div>
                            <div>
                                <p class="font-semibold text-navy-900 dark:text-white">U.S. Army — 19K M1 Armor Crewman</p>
                                <p class="text-sm text-text-muted dark:text-navy-400 mb-1">Fort Bliss, Texas — 2012-2016</p>
                                <p class="text-sm text-text-muted dark:text-navy-400">General Patton Jr. Award. Excellence in Armor. Tank Commander — $6.2M equipment responsibility.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
