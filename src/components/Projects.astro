---
import { getCollection } from 'astro:content'

const projects = (await getCollection('projects'))
    .filter((p) => p.data.visible)
    .sort((a, b) => a.data.position - b.data.position)

const projectIcons = {
    'Twin Gen AI': {
        icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z',
        color: 'from-violet-500 to-purple-600',
    },
    'AgilePulse AI': {
        icon: 'M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6',
        color: 'from-blue-500 to-cyan-500',
    },
    'Enterprise ETL Automation': {
        icon: 'M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.25 16.153 16.556 18 12 18s-8.25-1.847-8.25-4.125v-3.75m16.5 0c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125',
        color: 'from-emerald-500 to-teal-600',
    },
} as Record<string, { icon: string; color: string }>
---

<section id="projects" class="py-20 bg-navy-50 dark:bg-navy-900">
    <div class="mx-auto container w-4/5 md:w-3/5">
        <div data-animate class="text-center mb-12">
            <h2 class="text-4xl font-bold mb-3 text-navy-900 dark:text-white">Featured Projects</h2>
            <p class="text-lg text-text-muted dark:text-navy-300">AI-powered solutions delivering enterprise-scale impact</p>
        </div>

        <div class="space-y-8">
            {
                projects.map(async (project, i) => {
                    const { Content } = await project.render()
                    const { title, category, github, external, tags } = project.data
                    const iconData = projectIcons[title] || { icon: projectIcons['Twin Gen AI'].icon, color: 'from-primary to-accent' }

                    return (
                        <article
                            data-animate
                            style={`transition-delay: ${i * 0.15}s`}
                            class="group rounded-xl bg-white dark:bg-navy-800/50 border border-navy-100 dark:border-navy-800 overflow-hidden hover:border-accent/40 hover:shadow-xl transition-all"
                        >
                            <div class="flex flex-col md:flex-row">
                                {/* Icon Visual */}
                                <div class={`md:w-2/5 flex items-center justify-center p-8 md:p-12 bg-gradient-to-br ${iconData.color} relative overflow-hidden`}>
                                    {/* Background pattern */}
                                    <div class="absolute inset-0 opacity-10">
                                        <div class="absolute top-4 left-4 w-20 h-20 border-2 border-white rounded-full"></div>
                                        <div class="absolute bottom-4 right-4 w-32 h-32 border-2 border-white rounded-full"></div>
                                        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 border border-white rounded-full"></div>
                                    </div>
                                    <div class="relative text-white">
                                        <svg class="w-20 h-20 md:w-28 md:h-28 opacity-90 group-hover:scale-110 transition-transform duration-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" d={iconData.icon} />
                                        </svg>
                                    </div>
                                    <p class="absolute bottom-4 left-0 right-0 text-center text-white/60 text-xs font-medium uppercase tracking-widest">
                                        Proprietary
                                    </p>
                                </div>

                                {/* Content */}
                                <div class="md:w-3/5 p-6 md:p-8 flex flex-col justify-between">
                                    <div>
                                        <span class="text-xs font-semibold uppercase tracking-wider text-accent">
                                            {category}
                                        </span>
                                        <h3 class="text-2xl font-bold text-navy-900 dark:text-white mt-1 mb-3">
                                            {title}
                                        </h3>
                                        <div class="text-text-muted dark:text-navy-300 text-sm leading-relaxed mb-4">
                                            <Content />
                                        </div>
                                    </div>

                                    <div>
                                        {/* Tags */}
                                        <div class="flex flex-wrap gap-2 mb-4">
                                            {tags.map((tag) => (
                                                <span class="px-2.5 py-0.5 text-xs font-medium bg-navy-100 dark:bg-navy-700 text-navy-600 dark:text-navy-300 rounded">
                                                    {tag}
                                                </span>
                                            ))}
                                        </div>

                                        {/* Links */}
                                        <div class="flex gap-4">
                                            <a
                                                href={github}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`View ${title} on GitHub`}
                                                class="flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-primary dark:hover:text-accent transition-colors"
                                            >
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                    <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
                                                </svg>
                                                GitHub
                                            </a>
                                            <a
                                                href={external}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                aria-label={`View ${title} details`}
                                                class="flex items-center gap-1.5 text-sm font-medium text-text-muted hover:text-primary dark:hover:text-accent transition-colors"
                                            >
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                                </svg>
                                                Details
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </article>
                    )
                })
            }
        </div>
    </div>
</section>
